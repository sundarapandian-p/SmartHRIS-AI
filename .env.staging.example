# Staging template — copy to a secrets store or host-local .env (never commit real .env).
# Placeholders only. Replace every CHANGE_ME before use.

# Application
APP_NAME=SmartHRIS-AI
APP_ENV=staging
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit → FastAPI (set in the Streamlit process environment)
API_BASE_URL=http://CHANGE_ME_STAGING_API_HOST:8000

# MySQL 8.4 (staging database only — verify name before migrations)
DATABASE_URL=mysql+pymysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:3306/CHANGE_ME_DATABASE

# Pytest only — do not point staging API at smarthris_test
# TEST_DATABASE_URL=mysql+pymysql://...@127.0.0.1:3306/smarthris_test

# Authentication — generate JWT_SECRET_KEY offline (≥32 characters); never commit the real value
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama (RAG answers)
OLLAMA_BASE_URL=http://CHANGE_ME_OLLAMA_HOST:11434
OLLAMA_MODEL=llama3.2
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Embeddings + on-disk RAG storage (must exist and be writable on the API host)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_DOCUMENT_DIR=/var/lib/smarthris/staging/documents
RAG_INDEX_DIR=/var/lib/smarthris/staging/indexes

# Bulk import paths (private, not web-served)
# IMPORT_TEMP_DIR=/var/lib/smarthris/staging/imports
# MAX_UPLOAD_BYTES=52428800

# Streamlit security — leave unset on staging/production
# SMART_HRIS_STREAMLIT_PAGE_GUARD_TEST=
# SMART_HRIS_STREAMLIT_PROFILE_REFRESH_SECONDS=30