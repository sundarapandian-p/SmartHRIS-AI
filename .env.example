# Copy to .env and adjust values (never commit .env).

# Application
APP_NAME=SmartHRIS-AI
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000

# MySQL 8.4 — use a single URL or the MYSQL_* variables below.
DATABASE_URL=mysql+pymysql://smarthris:changeme@127.0.0.1:3306/smarthris

# Pytest integration tests use this database (create separately; never use production).
# TEST_DATABASE_URL=mysql+pymysql://smarthris:changeme@127.0.0.1:3306/smarthris_test

# Bulk employee import (Phase 3)
# IMPORT_BATCH_SIZE=500
# MAX_UPLOAD_BYTES=52428800
# IMPORT_TEMP_DIR=data/imports

# Optional overrides when DATABASE_URL is not set:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=smarthris
# MYSQL_PASSWORD=changeme
# MYSQL_DATABASE=smarthris
